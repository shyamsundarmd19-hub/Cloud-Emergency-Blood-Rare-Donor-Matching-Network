# ==============================================================================
# LifeLine Backend Environment Configuration (AWS Free Tier Ready)
# ==============================================================================

PROJECT_NAME="LifeLine - Emergency Blood & Rare Donor Network"
ENVIRONMENT="production"
DEBUG=False
SECRET_KEY="replace-with-a-random-64-character-hex-string-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database: AWS RDS PostgreSQL (db.t3.micro / db.t4g.micro Free Tier)
# Example: postgresql://postgres:StrongPassword2026@lifeline-db.c123456.us-east-1.rds.amazonaws.com:5432/lifeline
DATABASE_URL="sqlite:///./lifeline.db"

# AWS Region & S3 Configuration (5GB Free Tier)
AWS_REGION="us-east-1"
AWS_S3_BUCKET_NAME="lifeline-medical-documents"
AWS_S3_SSE_ALGORITHM="AES256"
MAX_FILE_SIZE_MB=10

# AWS SNS / SES Notifications
AWS_SNS_TOPIC_ARN=""
SMS_SENDER_ID="LifeLine"
AWS_SES_SENDER_EMAIL="alerts@lifeline-emergency.org"

# AWS IAM Credentials (Optional if running on EC2 with IAM Instance Profile attached)
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
